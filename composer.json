{
  "name": "watsonhaw/think-satoken",
  "description": "satoken extend for thinkphp6|8",
  "license": "MIT",
  "authors": [
    {
      "name": "watsonhaw",
      "email": "348748267@qq.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "satoken\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "satoken\\tests\\": "tests/"
    },
    "files": [
      "tests/helpers.php"
    ]
  },
  "require": {
    "php": "^8.0",
    "ramsey/uuid": "^4.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.2",
    "topthink/framework": "^8.0",
    "phpstan/phpstan": "^2.0"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "analyze": "phpstan analyze --no-progress --memory-limit=1G"
  },
  "extra": {
    "think": {
      "services": [
        "satoken\\Service"
      ],
      "config": {
        "satoken": "src/config/satoken.php"
      }
    }
  }
}